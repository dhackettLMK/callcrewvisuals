# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google accounts allowed to sign in, comma-separated. Also add each one to
# the public.allowed_emails table in Supabase.
ALLOWED_EMAILS=someone@example.com

# Google Drive folder the video library is loaded from (the ID at the end of
# the folder's URL). The folder must be shared as "Anyone with the link".
GOOGLE_DRIVE_FOLDER_ID=
# Google Cloud API key with the Google Drive API enabled. Server-only: never
# prefix it with NEXT_PUBLIC_.
GOOGLE_API_KEY=
